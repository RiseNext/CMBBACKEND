# =============================================================================
# Rise Next Banking CRM — BACKEND environment
# =============================================================================
#
#   cp .env.example .env      (run from the repository root)
#
# `src/config/env.ts` imports "dotenv/config", so this file is loaded from the
# current working directory. Every npm script runs from the repository root, so
# the file must live at ./.env.
#
# The zod schema in src/config/env.ts is the authority. It validates on boot and
# THROWS rather than starting with a bad configuration — a backend that starts
# with a missing JWT secret is worse than one that refuses to start.
#
# This file lists every variable the backend reads, including the two read
# outside the schema (LOG_LEVEL, and DATABASE_URL via drizzle.config.ts).
#
# NEVER commit a real .env. .gitignore already covers `.env` and `.env.*` while
# allowing `!.env.example`.
#
# Frontend variables (NEXT_PUBLIC_*) do NOT belong here — see the CMBFRONTEND
# repository's own .env.example.
#
# ── `# KEY=` AND `KEY=` ARE NOT THE SAME THING ───────────────────────────────
#
# This is the single most important convention in this file, and getting it
# wrong is what made an earlier version of it unusable.
#
#   # KEY=      the variable is ABSENT. dotenv never sets it, so the schema sees
#               `undefined` and `.optional()` applies. This is how an optional
#               integration is switched OFF.
#
#   KEY=        the variable is PRESENT with the value "". dotenv DOES set it.
#               `.optional()` does NOT apply — the key exists — so `z.enum(...)`
#               and `.min(1)` reject it and the process refuses to start.
#
# So every setting that is meant to be *off by default* is COMMENTED OUT below,
# not left as a bare `KEY=`. The one deliberate exception is AADHAAR_PEPPER,
# which ships as an empty `KEY=` precisely so that a straight copy of this file
# will NOT boot until you generate one. That refusal is the feature.
# =============================================================================


# ---------------------------------------------------------------- runtime ---

# development | test | production        Default: development
#
# ⚠️  MUST be exactly "production" in production. The refresh-cookie flags hinge
#     on it (src/lib/tokens.ts:74-82):
#       production → SameSite=None; Secure=true   ← required for a split
#                                                   frontend/backend deployment
#       otherwise  → SameSite=Lax;  Secure=false  ← the browser will STORE the
#                                                   cookie but never SEND it
#                                                   cross-site, so login appears
#                                                   to work and every page
#                                                   reload silently signs the
#                                                   user out.
#     It also raises the DB pool from 5 to 10 (src/db/index.ts:21) and enables
#     the two production-only config assertions below.
#
# ⚠️  REQUIRED — there is NO default (SEC-028, Task 1.7). The backend refuses
#     to start without it. It used to default to `development`, and because
#     nothing in this repository sets NODE_ENV — no Dockerfile, no railway.*,
#     no Procfile, no CI, and `npm start` is a bare `node dist/server.js` — a
#     production deploy that forgot the variable booted as development and
#     issued the refresh cookie with Secure=false; SameSite=Lax.
NODE_ENV=development

# HTTP port. Positive integer.          Default: 8080
PORT=8080

# pino log level: fatal|error|warn|info|debug|trace|silent
#                                       Default: info  ("silent" when NODE_ENV=test)
# Read RAW at src/lib/logger.ts:3 — it is NOT in the zod schema and is NOT
# validated. A typo silently falls through to pino's own default.
LOG_LEVEL=info


# --------------------------------------------------------------- database ---

# REQUIRED. Postgres connection string for the running application.
# With Neon, use the POOLED endpoint (the host containing "-pooler").
# SSL is enabled automatically unless the host contains "localhost"
# (src/db/index.ts:24).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional, but strongly recommended with Neon. Used ONLY by `npm run db:migrate`
# (src/db/migrate.ts:13), which falls back to DATABASE_URL when unset.
# Use the DIRECT (non-pooled) endpoint — DDL through a pooler can deadlock on
# session-scoped locks.
#
# Note: `npm run db:generate` (drizzle-kit) reads DATABASE_URL directly from
# drizzle.config.ts:7, not this variable. That only generates SQL from the
# schema and does not need a live connection.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require


# ------------------------------------------------------------------- auth ---

# REQUIRED. Minimum 32 characters each. Generate BOTH with:
#
#     openssl rand -base64 48
#
# ⚠️  The values below are placeholders, not secrets. They are long enough to
#     pass validation so that local development works immediately — which also
#     means a careless production deploy WILL BOOT with a publicly known signing
#     key. Unlike AADHAAR_PEPPER below, there is no known-bad-value guard on
#     these two. Replace them before the service is reachable by anyone.
#
# In production the two must DIFFER, or boot fails (src/config/env.ts:48-50).
JWT_ACCESS_SECRET=replace-me-openssl-rand-base64-48-aaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=replace-me-openssl-rand-base64-48-bbbbbbbbbbbbbbbb

# Access-token lifetime, as an `ms`/jsonwebtoken duration string.
#                                       Default: 15m
ACCESS_TOKEN_TTL=15m

# Refresh-token lifetime in days. Positive integer.
#                                       Default: 7
# Also sets the refresh cookie's maxAge (src/lib/tokens.ts:80).
REFRESH_TOKEN_TTL_DAYS=7

# Optional. Domain attribute on the refresh cookie. Omitted entirely when unset
# (src/lib/tokens.ts:85), which is what you want for a split deployment such as
# Vercel + Railway.
#
# ⚠️  LEAVE THIS UNSET unless the API and the frontend share a parent domain.
#     A value that does not match the API host makes the browser reject the
#     Set-Cookie outright, with the same symptom as a wrong NODE_ENV: login
#     succeeds, then every reload signs the user out.
# COOKIE_DOMAIN=.example.com


# ------------------------------------------------------------------- cors ---

# Comma-separated allow-list of browser origins. No wildcards — the API sends
# credentials, and `credentials: true` forbids a wildcard origin.
#                                       Default: http://localhost:3000
#
# Set this to the exact frontend origin in production (scheme + host, no
# trailing slash). A rejected origin currently surfaces as HTTP 500 rather than
# 403 (known defect BUG-022), so a misconfiguration here looks like a crash.
CORS_ORIGIN=http://localhost:3000

# The origin every emailed link is built from.
#                                       Default: http://localhost:3000
#
# ⚠️  MUST be set to the real frontend origin in production. Phase 3 wired this
#     up: `invitationUrl` (src/services/invitations.ts:55) and
#     `passwordResetUrl` (src/services/password-reset.ts:51) both build their
#     absolute link from it, and no domain is hardcoded anywhere.
#
#     Left at the default on a deployed backend, every invitation and every
#     password-reset email points at http://localhost:3000 — the mail sends
#     successfully and the link is useless to the recipient. Nothing in the
#     product can detect that, because a well-formed URL is all it checks.
#
#     (This block previously said the variable was "read by NOTHING in
#     application code … safe to leave at the default". That was true when it
#     was written and stopped being true in Phase 3. Corrected 2026-09-06,
#     Wave 0.)
FRONTEND_URL=http://localhost:3000


# -------------------------------------------------------------- bootstrap ---

# Optional pair, used ONLY by `npm run db:seed` (src/db/seed.ts:80-124) to
# create the very first Super Admin.
#
# ⚠️  If EITHER is unset the seed logs a warning and creates NO USER AT ALL.
#     The application then has zero accounts and nobody can sign in or create
#     anyone. This is the single most common first-deploy failure.
#
# The password must satisfy the policy: at least 12 characters with an
# uppercase letter, a lowercase letter, and a digit (src/lib/password.ts:89-98).
# The account is created with must_change_password = true, so this value stops
# being a valid credential after first sign-in.
#
# Set both, run the seed once, then REMOVE them from the environment.
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD=


# ----------------------------------------------------------------- policy ---

# Days a soft-deleted record stays in the recycle bin before it is eligible for
# purging. Positive integer.            Default: 30
#
# This is the FALLBACK. Since Task 12.6 the `recycleBin.retentionDays` setting
# in `app_settings` takes precedence when present, editable from the Settings
# screen by Super Admin and Admin; this value applies when no setting is stored.
#
# Task 15.9 gave it a consumer: `npm run jobs -- purge-recycle-bin` permanently
# removes entries whose window has elapsed, including their S3 objects. Nothing
# is purged until that job is scheduled — see docs/RUNBOOK.md.
RECYCLE_BIN_RETENTION_DAYS=30

# Maximum upload size in megabytes for the Excel customer importer.
# Positive integer.                     Default: 10
# Applied in src/modules/imports.routes.ts. This is the COMPRESSED size; Task
# 13.7 closed SEC-008 by adding a decompression ceiling of 20x this value, read
# from the ZIP local headers before the workbook is parsed, plus a 5,000-row cap
# that REFUSES rather than truncating. Raising this raises the inflation budget
# with it.
MAX_UPLOAD_MB=10


# ------------------------------------------------------------------- pii ----

# REQUIRED IN EVERY ENVIRONMENT. Minimum 32 characters. No default.
#
# The HMAC-SHA256 key over every stored Aadhaar number (src/lib/password.ts).
# Generate one with:
#
#     openssl rand -base64 48
#
# ⚠️  THERE IS NO DEFAULT AND NO PRODUCTION-ONLY EXEMPTION (SEC-007, Task 13.4).
#     It used to default to a value published in this repository, guarded only
#     by a `NODE_ENV === "production"` check — so STAGING and UAT, the
#     environments that get loaded with real customer data for acceptance
#     testing, peppered live Aadhaar numbers with a public constant. The schema
#     now refuses to start without a real value anywhere, and refuses the old
#     published placeholder by name.
#
#     This file therefore ships it EMPTY. `cp .env.example .env` will not boot
#     until you generate one, which is the intended behaviour.
#
# ⚠️  ROTATING THIS INVALIDATES EVERY STORED AADHAAR HASH. The mapping cannot be
#     recomputed — the raw numbers are never stored, which is the point. Aadhaar
#     search stops matching for every existing customer and cannot be repaired
#     from within the product. Treat it as permanent for the life of the
#     database. See docs/SECRETS.md for the full rotation procedure and its
#     consequences before you consider it.
AADHAAR_PEPPER=

# ------------------------------------------------------------------ email ---

# Transactional email — invitations, password setup and reset, and account
# security notices. Provider chosen in docs/DECISIONS.md D-033: **Resend**,
# starting on the free tier (3,000/month, 100/day as published).
#
# All four are OPTIONAL in development and test, and REQUIRED in production
# (src/config/env.ts). Leave the two below COMMENTED OUT and the backend boots
# on the console transport: it logs what it would have sent and delivers
# nothing. That is deliberate, so a developer with no mail credentials can still
# create an employee.
#
# ⚠️  "Leave them blank" means COMMENTED OUT, not `EMAIL_PROVIDER=`. See the
#     header — a bare `KEY=` is an empty STRING, which is a present value, and
#     `z.enum(["resend"])` and `.min(1)` both reject it. EMAIL_FROM and
#     EMAIL_REPLY_TO below are left set because their example values are valid
#     and harmless; the transport stays on the console until ALL FOUR are set
#     (`emailTransport()` in src/config/env.ts).
#
# ⚠️  PRODUCTION BOOT FAILS if any of the four is missing. Without them an
#     invitation would be accepted, written to stdout and reported as sent —
#     a control claiming an outcome it never achieved. Refusing to start is the
#     honest answer, and the failure names the missing keys (never their
#     values).
#
# Mail is live. `src/services/email.ts` delivers through Resend's REST API with
# `fetch` (no SDK — D-035), with three bounded retries on transport errors, 429
# and 5xx. Two flows depend on it: the employee invitation (Task 3.5) and the
# self-service password reset (3.6). Both build their absolute link from
# FRONTEND_URL above. See docs/EMAIL.md for the full flow map and the production
# test procedure.

# Which provider implementation to use. Allowlisted: the only accepted value is
# `resend`, because it is the only one implemented. A typo is a boot failure
# rather than a silent no-op. Leave COMMENTED OUT for the console transport.
# EMAIL_PROVIDER=resend

# Resend API key. Create at https://resend.com/api-keys — it begins `re_`.
#
# ⚠️  SECRET. Never commit a real value, here or anywhere else in this
#     repository. This file intentionally ships it with NO VALUE AT ALL rather
#     than a realistic-looking placeholder, so a copied .env cannot accidentally
#     look configured. Store the real value in the deployment's secret store.
# EMAIL_API_KEY=

# The From address. Either `user@example.com` or `Display Name <user@example.com>`
# — both are accepted, because the display-name form is what production usually
# uses. Must be a domain you have verified with Resend.
EMAIL_FROM=Rise Next <no-reply@example.com>

# Where replies go. Same two accepted formats. Point it somewhere a human reads;
# invitations and password mail invite replies whether or not you want them.
EMAIL_REPLY_TO=support@example.com


# ---------------------------------------------------------- observability ---

# Error tracking — Task 15.5. ALL OPTIONAL. Unset, errors go to the structured
# pino log at `error` level and nowhere else, which is what happens today and is
# not nothing: Railway collects stdout.
#
# Set ERROR_TRACKING_URL and the backend additionally POSTs a fixed JSON
# envelope to it for every 500 and every job that fails to start. There is no
# SDK and no vendor lock-in — any endpoint that accepts a JSON POST works
# (Sentry behind a relay, Better Stack, Highlight, or your own collector).
#
# ⚠️  WHAT IS SENT: the error name, message and stack; the HTTP method and the
#     ROUTE PATTERN (`/api/customers/:id`, never the filled URL); the request
#     id; the environment and release. A `pg` error's `detail` — which contains
#     the offending ROW VALUE — is stripped, and so is the `cause` chain, which
#     carries the connection string. Context values are scalars only.
#
#     An error tracker is a third party and this system holds Aadhaar and PAN.
#     Verify what your collector retains before enabling this.
# ERROR_TRACKING_URL=https://collector.example.com/ingest

# ⚠️  SECRET when set. Sent as `Authorization: Bearer`. Ships EMPTY.
# ERROR_TRACKING_TOKEN=

# How long to wait for the collector before giving up, in milliseconds.
#                                       Default: 3000
# The POST is fire-and-forget — a collector outage can never turn a handled 500
# into an unhandled rejection, and never adds latency to the failing request.
# ERROR_TRACKING_TIMEOUT_MS=3000

# Optional. The commit SHA of the running build, reported in the error envelope
# and nowhere else. Not a secret. On Railway, set it to $RAILWAY_GIT_COMMIT_SHA.
# RELEASE_SHA=


# ---------------------------------------------------------------- storage ---

# Object storage for KYC documents — Task 9.2/9.3, docs/DECISIONS.md D-071/D-072.
#
# The five credential/location keys below are OPTIONAL in development and test
# and REQUIRED in production (src/config/env.ts, the production block). Leave
# the four COMMENTED OUT and `services/storage.ts` builds a LOCAL FILESYSTEM
# adapter that writes under `./.storage/`, behind the same `StorageAdapter`
# interface. That is deliberate, so a developer with no bucket can still upload,
# download and verify a document.
#
# ⚠️  "Leave them blank" means COMMENTED OUT, not `STORAGE_PROVIDER=`. See the
#     header — a bare `KEY=` is a present empty string and the schema rejects
#     it. STORAGE_REGION is left set because `ap-south-1` is a decision (D-071),
#     not a credential, and a valid value there changes nothing: the adapter
#     stays local until ALL FIVE are set (`storageAdapterKind()`).
#
# ⚠️  PRODUCTION BOOT FAILS if any of the five is missing, and the failure names
#     the missing keys (never their values). The reason is sharper than the
#     email one: a Railway container's filesystem is EPHEMERAL, so a production
#     deploy that fell back to the local adapter would accept a KYC upload,
#     report success, and lose the file on the next restart — with the database
#     row left pointing at nothing. Refusing to start is the honest answer.
#
# ⚠️  NOT YET EXERCISED AGAINST A LIVE BUCKET. The S3 adapter signs its own
#     requests with AWS Signature V4 using `node:crypto` — no `@aws-sdk`
#     dependency (D-006). The signing is unit-tested for algorithmic
#     correctness (src/tests/storage-service.test.ts) but has never made a real
#     network call. Treat the first deployment as the integration test and
#     verify PUT, GET, DELETE and a presigned URL by hand before trusting it.

# Which adapter to build. Allowlisted: the only accepted value is `s3`, because
# it is the only one implemented — a typo is a boot failure, not a silent
# fallback. D-071 selected AWS S3 as the provider. Leave COMMENTED OUT for the
# local filesystem adapter.
# STORAGE_PROVIDER=s3

# Bucket name. Must be PRIVATE — Block Public Access on, no bucket policy
# granting anonymous reads. Nothing in this application ever hands out a bucket
# URL; downloads go through an authorization-checked route that either streams
# the bytes or mints a short-lived presigned URL.
# STORAGE_BUCKET=

# AWS region. D-071 fixes this at `ap-south-1` (Mumbai): OPEN-2 records data
# residency for Indian KYC documents as a LEGAL constraint, not a preference.
# Do not move the bucket out of India without re-opening that decision.
STORAGE_REGION=ap-south-1

# ⚠️  SECRETS. Never commit real values, here or anywhere in this repository.
#     Both intentionally ship with NO VALUE AT ALL rather than realistic-looking
#     placeholders, so a copied .env cannot accidentally look configured.
#     Store the real values in the deployment's secret store (Phase 15.10).
#
#     Scope the IAM principal to s3:PutObject, s3:GetObject and s3:DeleteObject
#     on this bucket's prefix ONLY. It needs no s3:ListBucket.
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Optional. Set ONLY for an S3-compatible provider that is not AWS (MinIO, R2,
# Wasabi). When unset the adapter addresses the bucket as
# `<bucket>.s3.<region>.amazonaws.com`. Leave blank for AWS.
# STORAGE_ENDPOINT=https://s3.example-provider.com

# Lifetime in seconds of a presigned download URL. Positive integer, max 3600.
#                                       Default: 300
# The URL's expiry is NOT the access control — the permission check on
# `GET /api/documents/:id/content` is. This only bounds how long a leaked link
# stays useful.
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Maximum size in megabytes of a single uploaded KYC document.
# Positive integer.                     Default: 15
# Applied at src/modules/documents.routes.ts:70.
#
# ⚠️  DELIBERATELY NOT `MAX_UPLOAD_MB` — D-072. That variable is the Excel
#     importer's zip-bomb decompression budget (SEC-008). Raising this limit to
#     fit a scanned multi-page bank statement must not raise the importer's
#     inflation ceiling as a side effect. Two limits, two risk profiles, two
#     keys.
MAX_DOCUMENT_MB=15

