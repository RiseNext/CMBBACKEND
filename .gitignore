# =============================================================================
# CMBBACKEND — ignore rules
# =============================================================================
#
# ORDERING IS LOAD-BEARING: within a .gitignore the LAST matching pattern wins,
# so `!.env.example` must come AFTER `.env.*`. Reversing them would hide the
# one template the setup instructions tell you to copy.
#
# Patterns without a slash match at ANY depth, so these apply recursively.
# =============================================================================

# ------------------------------------------------------------- secrets -----
#
# `.env.example` does NOT match the exact pattern `.env`, but it DOES match
# `.env.*` — hence the explicit negation.
.env
.env.*
!.env.example
!.env.*.example

# Credential/key material that must never reach the repository.
*.pem
*.key
*.p12
*.pfx

# ---------------------------------------------------------- dependencies ---
node_modules/

# ---------------------------------------------------------- build output ---
dist/
build/
*.tsbuildinfo

# ------------------------------------------------------- local artefacts ---
#
# The development fallback storage adapter writes here when the STORAGE_* keys
# are unset (src/services/storage.ts). It can contain real uploaded documents.
.storage/
uploads/tmp

# ---------------------------------------------------------------- logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------- coverage ----
coverage/
.nyc_output/
.vitest/

# --------------------------------------------------------- editors / os ----
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# VS Code: keep shared workspace settings trackable, ignore personal state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
